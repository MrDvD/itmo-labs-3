\subsubsection{Bipolar Alternate Mark Inversion (AMI)}

\begin{figure}[H]
\centering
\begin{adjustbox}{max width=\textwidth}
\begin{tikzpicture}
\def\bitseq{\VAR{ encoding_message.binary_list | join(',') }}
\def\cellW{0.8}
\def\lowY{0}
\def\zeroY{0.6}
\def\highY{1.2}
\def\bitsPerRow{16}
\def\rowH{2.8}
\def\totalBits{\VAR{ encoding_message.binary_list | length }}
\foreach \b [count=\i from 0] in \bitseq {
    \pgfmathtruncatemacro{\row}{int(\i/\bitsPerRow)}
    \pgfmathtruncatemacro{\col}{int(mod(\i,\bitsPerRow))}
    \pgfmathsetmacro{\yoff}{-\row*\rowH}
    \ifnum\b=0 \def\bitcolor{red} \else \def\bitcolor{blue} \fi
    \node[text=\bitcolor, font=\bfseries\large]
        at (\col*\cellW + 0.5*\cellW, \highY + 0.9 + \yoff) {\b};
}
\pgfmathtruncatemacro{\numRows}{int((\totalBits-1)/\bitsPerRow)+1}
\pgfmathtruncatemacro{\lastRow}{\numRows-1}
\foreach \r in {0,...,\lastRow} {
    \pgfmathsetmacro{\yoff}{-\r*\rowH}
    \pgfmathtruncatemacro{\startIdx}{\r*\bitsPerRow}
    \pgfmathtruncatemacro{\endIdxExcl}{\startIdx + \bitsPerRow}
    \ifnum\endIdxExcl>\totalBits
        \pgfmathtruncatemacro{\endIdxExcl}{\totalBits}
    \fi
    \pgfmathtruncatemacro{\bitsThisRow}{\endIdxExcl - \startIdx}
    \foreach \k in {0,...,\bitsThisRow} {
        \draw[dashed, thin, gray!70]
            (\k*\cellW, \lowY - 0.3 + \yoff) -- (\k*\cellW, \highY + 0.5 + \yoff);
    }
}
\xdef\curLevel{0}
\xdef\pulseSign{1}
\foreach \b [count=\i from 0] in \bitseq {
    \pgfmathtruncatemacro{\row}{int(\i/\bitsPerRow)}
    \pgfmathtruncatemacro{\col}{int(mod(\i,\bitsPerRow))}
    \pgfmathsetmacro{\yoff}{-\row*\rowH}
    \pgfmathsetmacro{\xL}{\col*\cellW}
    \pgfmathsetmacro{\xR}{\col*\cellW + \cellW}
    \ifnum\curLevel=0 \def\startY{\zeroY}
    \else\ifnum\curLevel=1 \def\startY{\highY}
    \else \def\startY{\lowY}\fi\fi

    \ifnum\b=0
        \def\targetLevel{0}
        \def\targetY{\zeroY}
        \def\segcolor{red}
    \else
        \ifnum\pulseSign=1
            \def\targetLevel{1}
            \def\targetY{\highY}
        \else
            \def\targetLevel{-1}
            \def\targetY{\lowY}
        \fi
        \pgfmathtruncatemacro{\nextPulseSign}{-\pulseSign}
        \xdef\pulseSign{\nextPulseSign}
        \def\segcolor{blue}
    \fi
    \ifnum\curLevel=\targetLevel
    \else
        \draw[thick] (\xL, \startY + \yoff) -- (\xL, \targetY + \yoff);
    \fi
    \draw[thick, \segcolor] (\xL, \targetY + \yoff) -- (\xR, \targetY + \yoff);

    \xdef\curLevel{\targetLevel}
}

\end{tikzpicture}
\end{adjustbox}
\caption{Временная диаграмма для AMI.}
\end{figure}

AMI (Alternate Mark Inversion) itself does not embed a reliable clock for long strings of zeros; practical systems therefore add zero-substitution rules such as HDB3, B3ZS, B6ZS or B8ZS. These force artificial violations that create transitions while remaining DC-balanced.

