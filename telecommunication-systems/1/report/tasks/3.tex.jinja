\end{tblr}
\caption{Результаты логического кодирования методом 4B/5B.}
\end{table}

По условию работы требуется изобразить временную диаграмму для одного из методов, отмеченных в предыдущем разделе в качестве наилучших. Заранее отметим, что было бы целесообразным попытаться улучшить сигнал метода AMI, отмеченного как худший из представленных, однако не будем искажать условие.

Изобразим сигнал полученного сообщения на временной диаграмме:

\begin{figure}[H]
\centering
\begin{adjustbox}{max width=\textwidth}
\begin{tikzpicture}
\def\bitseq{\VAR{ b4b5_message.binary_list | join(',') }}
\def\cellW{0.8}
\def\lowY{0}
\def\zeroY{0.6}
\def\highY{1.2}
\def\bitsPerRow{16}
\def\rowH{2.8}
\def\totalBits{\VAR{ b4b5_message.binary_list | length }}
\foreach \b [count=\i from 0] in \bitseq {
    \pgfmathtruncatemacro{\row}{int(\i/\bitsPerRow)}
    \pgfmathtruncatemacro{\col}{int(mod(\i,\bitsPerRow))}
    \pgfmathsetmacro{\yoff}{-\row*\rowH}
    \ifnum\b=0 \def\bitcolor{red} \else \def\bitcolor{blue} \fi
    \node[text=\bitcolor, font=\bfseries, bg=gray!15\large]
        at (\col*\cellW + 0.5*\cellW, \highY + 0.9 + \yoff) {\b};
}
\pgfmathtruncatemacro{\numRows}{int((\totalBits-1)/\bitsPerRow)+1}
\pgfmathtruncatemacro{\lastRow}{\numRows-1}
\foreach \r in {0,...,\lastRow} {
    \pgfmathsetmacro{\yoff}{-\r*\rowH}
    \pgfmathtruncatemacro{\startIdx}{\r*\bitsPerRow}
    \pgfmathtruncatemacro{\endIdxExcl}{\startIdx + \bitsPerRow}
    \ifnum\endIdxExcl>\totalBits
        \pgfmathtruncatemacro{\endIdxExcl}{\totalBits}
    \fi
    \pgfmathtruncatemacro{\bitsThisRow}{\endIdxExcl - \startIdx}
    \foreach \k in {0,...,\bitsThisRow} {
        \draw[dashed, thin, gray!70]
            (\k*\cellW, \lowY - 0.3 + \yoff) -- (\k*\cellW, \highY + 0.5 + \yoff);
    }
}
\foreach \b [count=\i from 0] in \bitseq {
    \pgfmathtruncatemacro{\row}{int(\i/\bitsPerRow)}
    \pgfmathtruncatemacro{\col}{int(mod(\i,\bitsPerRow))}
    \pgfmathsetmacro{\yoff}{-\row*\rowH}
    \pgfmathsetmacro{\xL}{\col*\cellW}
    \pgfmathsetmacro{\xM}{\col*\cellW + 0.5*\cellW}
    \pgfmathsetmacro{\xR}{\col*\cellW + \cellW}

    \ifnum\b=0
        \pgfmathsetmacro{\pulseY}{\lowY}
        \def\segcolor{red}
    \else
        \pgfmathsetmacro{\pulseY}{\highY}
        \def\segcolor{blue}
    \fi

    \draw[thick] (\xL, \zeroY + \yoff) -- (\xL, \pulseY + \yoff);
    \draw[thick, \segcolor] (\xL, \pulseY + \yoff) -- (\xM, \pulseY + \yoff);
    \draw[thick] (\xM, \pulseY + \yoff) -- (\xM, \zeroY + \yoff);
    \draw[thick] (\xM, \zeroY + \yoff) -- (\xR, \zeroY + \yoff);
}
\end{tikzpicture}
\end{adjustbox}
\caption{Временная диаграмма для 4B/5B+RZ.}
\end{figure}

