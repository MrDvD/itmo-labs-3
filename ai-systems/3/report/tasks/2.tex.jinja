\subsubsection{PR-кривая}

\subsubsubsection{Определения}

\textbf{Accuracy} --- метрика, которая показывает долю верно классифицированных объектов относительно всех объектов:
\begin{equation}
    \text{Accuracy}=\dfrac{\text{TP}+\text{TN}}{\text{TP}+\text{FN}+\text{FP}+\text{TN}},
    \label{eq:accuracy}
\end{equation}

где:
\begin{itemize}
    \item \textbf{TP} (True Positive) --- количество верно классифицированных объектов положительного класса;
    \item \textbf{TN} (True Negative) --- количество верно классифицированных объектов отрицательного класса;
    \item \textbf{FP} (False Positive) --- количество неверно классифицированных объектов отрицательного класса как положительные;
    \item \textbf{FN} (False Negative) --- количество неверно классифицированных объектов положительного класса как отрицательные.
\end{itemize}

\textbf{Recall} \textit{(True Positive Rate)} --- метрика, которая показывает долю верно классифицированных объектов положительного класса относительно всех объектов положительного класса:
\begin{equation}
    \text{TPR}=\text{R}=\dfrac{\text{TP}}{\text{TP}+\text{FN}},
    \label{eq:recall}
\end{equation}

\textbf{Precision} \textit{(Positive Predictive Value)} --- метрика, которая показывает долю верно классифицированных объектов положительного класса относительно всех модельных объектов положительного класса:
\begin{equation}
    \text{PPV}=\text{P}=\dfrac{\text{TP}}{\text{TP}+\text{FP}},
    \label{eq:precision}
\end{equation}

