\paragraph{Интерактивный график \texttt{plotly}.} Как построить интерактивную матрицу корреляции численных признаков из нашего набора данных?

\begin{lstlisting}[caption={Скрипт построения интерактивного графика \texttt{plotly}.}]
import plotly.graph_objects as go

numeric_cols = student_gen.select_dtypes(include=['int64', 'float64']).columns
corr_matrix = student_gen[numeric_cols].corr()

fig = go.Figure(data=go.Heatmap(
    z=corr_matrix.values,
    x=corr_matrix.columns,
    y=corr_matrix.index,
    colorscale='RdBu',
    zmin=-1, zmax=1,
    text=corr_matrix.round(2).values,
    texttemplate="%{text}"
))

fig.update_layout(
    title="Correlation Matrix Heatmap",
    width=800, height=800
)
fig.show()
\end{lstlisting}