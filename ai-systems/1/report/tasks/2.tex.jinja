\begin{itemize}
    \item \textbf{Ridge ($L_2$):} $RMSE = \mathbf{\VAR{ regularization_results.ridge.metrics.test_rmse | round(5) }}$, $R^2 = \mathbf{\VAR{ regularization_results.ridge.metrics.test_r2 | round(5) }}$, $MAE = \mathbf{\VAR{ regularization_results.ridge.metrics.test_mae | round(5) }}$;
    \item \textbf{Lasso ($L_1$):} $RMSE = \mathbf{\VAR{ regularization_results.lasso.metrics.test_rmse | round(5) }}$, $R^2 = \mathbf{\VAR{ regularization_results.lasso.metrics.test_r2 | round(5) }}$, $MAE = \mathbf{\VAR{ regularization_results.lasso.metrics.test_mae | round(5) }}$.
\end{itemize}