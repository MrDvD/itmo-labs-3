    cells = {c, m},
}
\textbf{Уровень доверия} & 0,9 & 0,95 & 0,99 \\
\textbf{Квантиль} & 1,645 & 1,960 & 2,576 \\
\end{tblr}
\caption{Квантили стандартного нормального распределения}
\end{table}

Из \eqref{eq:central_limit_theorem} и \eqref{eq:confidence_interval} следует, что:
\[
    \Delta \mu(A) = \abs{\overline{X}-\mu} = c\cdot\dfrac{\sigma(A)}{\sqrt{n}}
\]

